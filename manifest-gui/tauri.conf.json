{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manifest",
  "version": "0.2.0",
  "identifier": "me.pbweb.manifest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manifest",
        "width": 1000,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Mod load-order ledger for Ship of Harkinian",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNTY5QkEyNUE1NDIzRjMKUldUekkxUmFvcHRXL0VYMHRZSjh3QkR4V0dBdEZyR0pZVFpxdVZIQUtITkM4eThnMjRBSlFsNnIK",
      "endpoints": [
        "https://github.com/proverbiallemon/Manifest/releases/latest/download/latest.json"
      ]
    }
  }
}
